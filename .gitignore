# Julia
*.jl.cov
*.jl.*.cov
*.jl.mem
/docs/build/

# Resolved manifests for the package itself are committed; sub-env manifests
# (test, crossval) are regenerated and not tracked.
/test/Manifest.toml
/crossval/Manifest.toml

# Cross-validation scratch
/crossval/__pycache__/
*.bin
oracle.json

# Editors / OS
.DS_Store
*.swp

# Sysimage sub-env manifest, and the built image itself: several hundred MB,
# machine- and Julia-version-specific.  Rebuild with sysimage/build_sysimage.jl.
/sysimage/Manifest.toml
/sysimage/*.so
/sysimage/*.dylib
/sysimage/*.dll

# Benchmark sub-env manifest (regenerated) and profiler HTML output
/bench/Manifest.toml
/bench/statprof/
# interp_bench.jl output (regenerate with `julia --project=bench bench/interp_bench.jl`)
/bench/interp_bench_*.png
/bench/interp_bench.csv
